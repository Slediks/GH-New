# Generate both secrets locally; never commit the resulting .env.
POSTGRES_PASSWORD=
SECRET_KEY=
APP_ENV=production
AUTH_ADAPTER=unconfigured
AUTH_URL=
# JSON adapter is a template. Fill ONLY after obtaining the real API contract.
AUTH_CONTRACT=
AUTH_HEADERS={}
# Optional opaque client context for the external LAN authentication API.
# Generate a unique 32-byte key and configure the same key on that API.
AUTH_CONTEXT_KEY=
AUTH_CONTEXT_HEADER=X-Request-Context
# One external HTTP port; no public hostname/IP configuration is needed.
GAMEHUB_PORT=8080
GAMEHUB_VERSION=3.2.3
# HTTP LAN mode: no Secure requirement and no cookie Domain attribute.
COOKIE_SECURE=false
SESSION_SECONDS=43200
FOOTBALL_DEBUG=0
